#!/usr/bin/env bash
# Stand-in for the GitHub CLI inside an eval sandbox. It records every call in
# $GH_SHIM_LOG and answers from canned files, so a session can neither read nor
# change anything on GitHub.
#
# Canned answers live in $GH_CANNED as <command>_<subcommand>.json (used when
# the call asks for --json; filtered by --jq when given) or .txt.
printf '%s\n' "$*" >> "${GH_SHIM_LOG:-/dev/null}"

cmd="${1:-}"; sub="${2:-}"
want_json=0; jq_expr=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[i]}" in
    --json) want_json=1 ;;
    --json=*) want_json=1 ;;
    --jq|-q) jq_expr="${args[i+1]:-}" ;;
    --jq=*) jq_expr="${args[i]#--jq=}" ;;
  esac
done

canned="${GH_CANNED:-/nonexistent}/${cmd}_${sub}"
emit_json() {
  if [[ -n "$jq_expr" ]]; then jq -r "$jq_expr" "$1"; else cat "$1"; fi
}

if [[ "$cmd" == "api" ]]; then
  if [[ -f "${GH_CANNED:-/nonexistent}/api.json" ]]; then emit_json "$GH_CANNED/api.json"; else echo '{}'; fi
  exit 0
fi
# A scenario may seed pr_view.after_create.json: `pr view` then finds no PR until `pr create` was logged. The state
# follows the logged calls: a draft only when the create call had --draft, ready after `pr ready`, an armed
# autoMergeRequest after `pr merge --auto`, and MERGED after any other `pr merge`.
after_create="${GH_CANNED:-/nonexistent}/pr_view.after_create.json"
if [[ "$cmd $sub" == "pr view" && -f "$after_create" ]]; then
  shim_log="${GH_SHIM_LOG:-/dev/null}"
  if ! grep -q '^pr create' "$shim_log" 2>/dev/null; then
    echo "no pull requests found for the current branch" >&2; exit 1
  fi
  draft=false; state=OPEN; auto=null
  if grep '^pr create' "$shim_log" | tail -1 | grep -Eq -- '--draft|(^| )-d( |$)'; then draft=true; fi
  if grep -q '^pr ready' "$shim_log"; then draft=false; fi
  merge_line="$(grep '^pr merge' "$shim_log" | grep -v -- '--disable-auto' | tail -1 || true)"
  if [[ -n "$merge_line" ]]; then
    if [[ "$merge_line" == *--auto* ]]; then auto='{"enabledAt":"2026-11-17T10:00:00Z","mergeMethod":"SQUASH"}'
    else state=MERGED; fi
  fi
  src="$(mktemp)"
  jq --argjson d "$draft" --arg s "$state" --argjson a "$auto" '.isDraft = $d | .state = $s | .autoMergeRequest = $a' \
    "$after_create" > "$src"
  if [[ $want_json -eq 1 ]]; then emit_json "$src"; else echo "#7 change ($state)"; fi
  rm -f "$src"
  exit 0
fi
if [[ $want_json -eq 1 && -f "$canned.json" ]]; then emit_json "$canned.json"; exit 0; fi
if [[ -f "$canned.txt" ]]; then cat "$canned.txt"; exit 0; fi

case "$cmd $sub" in
  "auth status") echo "github.com: logged in to github.com account joeharris76 (sandbox)" ;;
  "pr create") echo "https://github.com/example/inventory/pull/7" ;;
  "pr merge") echo "Merged pull request" ;;
  "pr list") [[ $want_json -eq 1 ]] && echo '[]' ;;
  "pr view"|"pr checks"|"pr status") echo "no pull requests found" >&2; exit 1 ;;
  "repo view")
    if [[ $want_json -eq 1 ]]; then
      echo '{"name":"inventory","nameWithOwner":"example/inventory","defaultBranchRef":{"name":"main"},"url":"https://github.com/example/inventory"}' > /tmp/gh-shim-repo.$$
      emit_json /tmp/gh-shim-repo.$$; rm -f /tmp/gh-shim-repo.$$
    else
      echo "example/inventory"
    fi ;;
  *) : ;;
esac
exit 0
