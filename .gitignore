.DS_Store

# Platform-managed Codex/OpenAI system skills (skill-creator, imagegen,
# etc.). Dropped in by the agent runtime, versioned via
# .codex-system-skills.marker, and not referenced by skill-sync.yaml /
# skill-sync.lock -- so skill-sync does not source or distribute them.
skills/.system/

# Per-target config generated by `skill-sync sync` (writeProjectConfig in
# src/core/config-generator.ts writes CONFIG_FILENAME into every target dir).
# ~/.claude/skills and ~/.codex/skills are symlinks to this repo's skills/
# tree, so a sync run against those targets writes the file straight into
# this checkout. It is generated deploy output describing the *consuming*
# project, not canonical skill source, and skill-sync itself already exempts
# it from orphan detection (src/core/drift.ts). Ignore it rather than
# tracking it, so a sync never leaves the canonical checkout dirty.
skills/skill-sync.config.yaml
